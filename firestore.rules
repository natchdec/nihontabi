rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 't'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 200000;
    }
    // Group polls: link holders (signed in) can read one poll by id; only the owner can list/delete their own polls.
    match /polls/{pid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'title', 'hub', 'month', 'options', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.options is list && request.resource.data.options.size() >= 2 && request.resource.data.options.size() <= 12;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /votes/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['n', 'picks', 't'])
          && request.resource.data.n is string && request.resource.data.n.size() <= 60
          && request.resource.data.picks is list && request.resource.data.picks.size() <= 12;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
